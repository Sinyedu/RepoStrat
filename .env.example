NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DATABASE_URL=file:./data/repostrat.db

# GitHub App installation for project registration; optional at startup.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Maximum Discord posts created or edited by one /project sync run.
SYNC_BATCH_SIZE=50
